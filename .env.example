# Copia questo file in .env e modifica i valori prima della pubblicazione.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Credenziali demo SOLO per sviluppo locale. Cambiale prima di esporre il sito online.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# In produzione usa una stringa casuale lunga e imprevedibile (almeno 32 caratteri).
# Esempio per generarla: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=local-demo-secret-change-before-production-please-123456789

# Facoltativo: percorso alternativo al file dati JSON
DATA_FILE=./data/database.json
